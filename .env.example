# Local trial; use the private service URL for container deployments.
COBALT_API_URL=http://127.0.0.1:9000/
EXTRACTION_PROVIDERS=cobalt,ytdlp,public_photos
PORT=10000
# COBALT_API_KEY= set only if your own instance requires an API key

INSTAGRAM_PROVIDERS=instagram,ytdlp,cobalt
YOUTUBE_PROVIDERS=ytdlp,cobalt
YOUTUBE_MAX_HEIGHT=720
